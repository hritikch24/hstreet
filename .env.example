# High Street Shopfronts: environment variables.
# Every value here belongs to this site alone. Never paste in a database URL,
# key or token that another site uses.

# Postgres for this site only (e.g. a new Neon or Vercel Postgres database).
DATABASE_URL=

# Back office: open /hq?key=<HQ_KEY> once per browser. 16+ random characters.
HQ_KEY=

# Read-only metrics page: /metrics?key=<METRICS_KEY>. Counts only, no customer
# data. Leave empty to use the default key "admin".
METRICS_KEY=

# Bearer token the owner's combined metrics dashboard sends to /api/hq/stats.
# 16+ random characters, different from HQ_KEY.
HQ_STATS_TOKEN=

# Enquiry notification emails via Resend (optional; enquiries are saved either way).
RESEND_API_KEY=
ENQUIRY_EMAIL_TO=
ENQUIRY_EMAIL_FROM=

# AI-drafted replies in /hq (optional).
ANTHROPIC_API_KEY=

# This site's own IndexNow key (32 hex characters). Served at /indexnow-key.txt.
INDEXNOW_KEY=
